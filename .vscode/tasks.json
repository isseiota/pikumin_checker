{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start server",
			"type": "shell",
			"command": "node server.js",
			"isBackground": true,
			"group": "build",
			"problemMatcher": {
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^Server running",
					"endsPattern": "^Server running"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "Open app in browser",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"start",
				"",
				"http://localhost:3000"
			],
			"isBackground": false,
			"group": "build",
			"dependsOn": "Start server"
		}
	]
}